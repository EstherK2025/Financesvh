# ───────────────────────────────────────────────────────────
# Finances VH — copier ce fichier en `.env` (local) et reporter les mêmes
# variables dans Vercel (Réglages → Environment Variables).
# ⚠️ Ne jamais mettre de vraies valeurs secrètes dans ce fichier.
# ───────────────────────────────────────────────────────────

# Base de données Postgres (Neon recommandé).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Mot de passe demandé UNE SEULE FOIS pour créer le premier super admin
# (page /installation). Obligatoire en production.
FIN_SETUP_PASSWORD=change_me_setup_password

# Secret de signature (étape « code par courriel »). Chaîne longue et aléatoire.
FIN_SECRET=change_me_long_random_string

# Resend — envoi des courriels (codes de connexion, invitations, notifications).
# ⚠️ Indispensable en production : sans clé, le code de connexion n'est
# visible que dans les logs du serveur.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=Finances VH <events@evhnb.ca>

# URL publique du site (liens dans les courriels).
NEXT_PUBLIC_BASE_URL=https://finances.eventsevhnb.ca
